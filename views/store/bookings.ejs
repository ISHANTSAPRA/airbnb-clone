<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="container mx-auto mt-20 text-center">

      <h2 class="text-6xl font-bold text-red-500 mb-4">
        My Bookings
      </h2>

      <% if (bookedHomes.length === 0) { %>

        <p class="text-2xl text-gray-700 mb-8">
          Bookings will appear here
        </p>

      <% } else { %>

        <div class="flex flex-wrap justify-center gap-6 mt-10">

          <% bookedHomes.forEach(home => { %>

            <div class="bg-white rounded-lg shadow-md overflow-hidden w-full max-w-sm">

              <img
                src="<%= home.photoUrl %>"
                alt="<%= home.houseName %>"
                class="w-full h-48 object-cover"
              >

              <div class="p-4 text-left">

                <h3 class="text-xl font-semibold text-gray-800 mb-2">
                  <%= home.houseName %>
                </h3>

                <p class="text-gray-600 mb-2">
                  <%= home.location %>
                </p>

                <p class="text-lg font-bold text-red-500">
                  Rs<%= home.price %> / night
                </p>

                <p class="text-gray-700 mt-2">
                  Rating: <%= home.rating %>
                </p>

              </div>

            </div>

          <% }) %>

        </div>

      <% } %>

    </main>

  </body>
</html>
